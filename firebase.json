{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/robots.txt",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "/sitemap.xml",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ],
    "rewrites": [
      { "source": "/premium", "destination": "/premium.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/gestor", "destination": "/gestor.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/privacidade", "destination": "/privacidade.html" },
      { "source": "/termos", "destination": "/termos.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "linkinggo-payments",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
